<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  R for Windows 4.2.0 and later uses UTF-8 as its native encoding only when
  the process it runs in has the UTF-8 code page, which R's own executables
  get from a manifest setting like this one. An embedding executable without
  it leaves R on the system code page (1252 on most English systems), so
  strings outside that code page cannot be represented in the R session.
  Needs Windows 10 version 1903 or later; older systems ignore the setting.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
